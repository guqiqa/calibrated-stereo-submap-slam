<?xml version="1.0"?>
<sdf version="1.6">
  <world name="terminal_basic">
    <gravity>0 0 -9.81</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.35 0.35 0.35 1</ambient>
      <background>0.08 0.10 0.14 1</background>
      <shadows>true</shadows>
    </scene>
    <include><uri>model://sun</uri></include>
    <include>
      <uri>model://stereo_robot</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>154 12 0.1</size></box></geometry></collision>
