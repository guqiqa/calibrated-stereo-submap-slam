<?xml version="1.0"?>
<sdf version="1.6">
  <model name="stereo_robot">
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_link">
      <pose>0 0 0.12 0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.1233</ixx>
          <iyy>0.1958</iyy>
          <izz>0.2651</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><box><size>0.45 0.34 0.18</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><box><size>0.45 0.34 0.18</size></box></geometry>
        <material>
          <ambient>0.12 0.22 0.32 1</ambient>
          <diffuse>0.18 0.36 0.52 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="stereo_left_frame">
      <pose>0.08 0.035 0.32 0 0 0</pose>
      <visual name="left_mount">
        <geometry><box><size>0.08 0.07 0.07</size></box></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="left_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip>
        </camera>
        <plugin name="left_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros><namespace>/sim</namespace><remapping>image_raw:=left/image_raw</remapping><remapping>camera_info:=left/camera_info</remapping></ros>
          <camera_name>left</camera_name>
          <frame_name>stereo_left_optical_frame</frame_name>
        </plugin>
      </sensor>
    </link>

    <link name="stereo_right_frame">
      <pose>0.08 -0.035 0.32 0 0 0</pose>
      <visual name="right_mount">
        <geometry><box><size>0.08 0.07 0.07</size></box></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="right_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip>
        </camera>
        <plugin name="right_camera_plugin" filename="libgazebo_ros_camera.so">
          <ros><namespace>/sim</namespace><remapping>image_raw:=right/image_raw</remapping><remapping>camera_info:=right/camera_info</remapping></ros>
          <camera_name>right</camera_name>
          <frame_name>stereo_right_optical_frame</frame_name>
          <hack_baseline>0.07</hack_baseline>
        </plugin>
      </sensor>
    </link>

    <joint name="left_mount_joint" type="fixed">
      <parent>base_link</parent><child>stereo_left_frame</child>
    </joint>
    <joint name="right_mount_joint" type="fixed">
      <parent>base_link</parent><child>stereo_right_frame</child>
    </joint>

    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/sim</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>100</update_rate>
      <publish_rate>20</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>sim_odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </model>
</sdf>
