/experiments/**/*.pid
/experiments/**/*.lock

# Temporary and machine-local files
*.tmp
*.bak
*.swp
Thumbs.db
desktop.ini

# 大体积研究资产：默认不入库（确需入库用 git add -f）
/paper_package/

# 实验目录：默认只保留轻量结果文件；逐帧数据、地图、rosbag、图片一律忽略
